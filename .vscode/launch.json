{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch PWA in Chrome (Display Mode)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/pwa",
      "runtimeArgs": [
        "--app=http://localhost:3000",
        "--autoplay-policy=no-user-gesture-required"
      ]
    },
    {
      "name": "Launch PWA in Chrome (Remote Mode)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/pwa"
    },
    {
      "name": "Debug Pure Unit Tests (Node.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/pwa/scripts/check-pure.mjs",
      "cwd": "${workspaceFolder}/pwa",
      "console": "integratedTerminal"
    }
  ]
}

