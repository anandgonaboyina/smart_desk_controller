{
  "name": "pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:hardware": "powershell -ExecutionPolicy Bypass -File \"../../build_hardware.ps1\"",
    "predev": "npx @tailwindcss/cli -i app/input.css -o app/globals.css",
    "dev": "next dev",
    "prebuild": "npx @tailwindcss/cli -i app/input.css -o app/globals.css --minify",
    "build": "next build",
    "postinstall": "node scripts/patch-next.js",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
